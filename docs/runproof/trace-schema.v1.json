{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:candle-climber:runproof:trace:v1",
  "title": "RunTrace prototype trace v1 (runproof/v1 wire format)",
  "type": "object",
  "required": ["format", "prototype", "seed", "terrain", "mutationId", "ticks", "inputs", "claims"],
  "properties": {
    "format": { "const": "runproof/v1" },
    "prototype": { "const": true },
    "recorder": {
      "type": "object",
      "required": ["format", "id", "version", "tickHz"],
      "properties": {
        "format": { "const": "cc-fixed-tick-input/v1" },
        "id": { "enum": ["candle-climber-runproof-demo", "candle-climber-runtrace-rival-qa"] },
        "version": { "const": 1 },
        "tickHz": { "const": 60 }
      },
      "additionalProperties": false
    },
    "seed": {
      "type": "object",
      "required": ["date", "symbol"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "symbol": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,24}$" }
      },
      "additionalProperties": false
    },
    "terrain": {
      "type": "object",
      "required": ["kind", "candles"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "candles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["t", "o", "h", "l", "c"],
            "properties": {
              "t": { "type": "number" },
              "o": { "type": "number" },
              "h": { "type": "number" },
              "l": { "type": "number" },
              "c": { "type": "number" },
              "v": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "mutationId": { "type": "string" },
    "ticks": { "type": "integer", "minimum": 1, "maximum": 7200 },
    "inputs": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": ["tick", "action"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0 },
          "action": { "enum": ["jump-down", "jump-up", "rush-down", "rush-up", "enter-world2"] }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "object",
      "required": ["score", "candlesPassed", "bestStreak", "deathCause", "jumpTicks", "landTicks", "scoreEvents"],
      "properties": {
        "score": { "type": "integer", "minimum": 0 },
        "candlesPassed": { "type": "integer", "minimum": 0 },
        "bestStreak": { "type": "integer", "minimum": 0 },
        "deathCause": { "enum": ["fell", "crumbled", "wicked", null] },
        "jumpTicks": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "landTicks": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "scoreEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tick", "score", "combo", "candlesPassed"],
            "properties": {
              "tick": { "type": "integer", "minimum": 0 },
              "score": { "type": "integer", "minimum": 0 },
              "combo": { "type": "integer", "minimum": 0 },
              "candlesPassed": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
